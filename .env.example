# Copy to .env and fill in credentials for the model service you intend to use.
# Never commit .env or paste its values into reports or logs.
OPENAI_API_KEY=
OPENAI_BASE_URL=
COATING_LLM_MODEL=gpt-6.1-terra
COATING_LLM_API=responses
# Optional; omit if the selected model does not support reasoning effort.
COATING_LLM_REASONING_EFFORT=low
